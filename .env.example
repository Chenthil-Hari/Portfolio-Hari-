# ============================================================
#  HARITECH PORTFOLIO & AI EMAIL AGENT — ENVIRONMENT CONFIG
# ============================================================

# ── MongoDB Atlas Database ──
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.pekileo.mongodb.net/?appName=Cluster0
MONGODB_DB=portfolio

# ── Admin Dashboard Access ──
ADMIN_PASSWORD=admin123

# ── Transactional Email (Resend) ──
RESEND_API_KEY=re_xxxxxxxxx
OWNER_EMAIL=chenthilhari@gmail.com

# ── Haritech AI Email Agent (OpenAI) ──
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ── Telegram Approval Workflow ──
# 1. Create your bot with @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
# 2. Start a chat with @userinfobot to get your numeric TELEGRAM_ALLOWED_USER_ID
# 3. Register your webhook by visiting:
#    https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook?url=https://haritech.me/api/telegram-webhook
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_ALLOWED_USER_ID=123456789
TELEGRAM_WEBHOOK_SECRET=optional_random_secret_token

# ── Gmail API OAuth 2.0 (Direct Inbox & Reply Dispatch) ──
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Enable the Gmail API (https://mail.google.com/ or https://www.googleapis.com/auth/gmail.send)
# 3. Create OAuth 2.0 Client IDs (Web application or Desktop application)
# 4. Generate a Refresh Token using OAuth 2.0 Playground or Google OAuth flow
GMAIL_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
GMAIL_REFRESH_TOKEN=1//0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_USER_EMAIL=chenthilhari@gmail.com

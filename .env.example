# ============================================================
# Haritech Portfolio — Environment Configuration Template
# ============================================================

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/portfolio?retryWrites=true&w=majority

# Resend API Key for Transactional Emails
RESEND_API_KEY=re_your_api_key_here

# Portfolio Owner Email (where inquiries, notifications and alerts are received)
OWNER_EMAIL=chenthilhari@gmail.com

# Admin Dashboard Password (used to unlock /admin and authenticate API updates)
ADMIN_PASSWORD=your_secure_admin_password_here
